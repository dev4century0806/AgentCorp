{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@shared": ["./shared/protocol.ts"] }
  },
  "include": ["ui/src/**/*.ts", "shared/**/*.ts"]
}
